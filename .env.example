# Copy to .env (gitignored). Defaults in support/env.ts match the take-home project,
# so these are only needed to point the suites somewhere else.
RHOMBUS_BASE_URL=https://rhombusai.com
RHOMBUS_PROJECT_NAME=drift-qa
# API origin seen in DevTools Network
RHOMBUS_API_URL=

S3_CONNECTION=orders-input
S3_BUCKET=violet-rhombus-drift-in
S3_PREFIX=input/
GCS_BUCKET=violet-rhombus-drift-out
