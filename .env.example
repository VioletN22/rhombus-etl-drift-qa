# Copy to .env (gitignored). Never commit real values.
RHOMBUS_EMAIL=
RHOMBUS_PASSWORD=
RHOMBUS_BASE_URL=https://rhombusai.com
# API origin seen in DevTools Network on discovery day (may differ from the app origin)
RHOMBUS_API_URL=
RHOMBUS_PROJECT_NAME=

AWS_REGION=ap-southeast-2
S3_BUCKET=
S3_KEY=input/orders.csv

GCS_BUCKET=
GCS_PREFIX=
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# Cron exactly as the Rhombus schedule UI displays it, e.g. "0 6 * * *"
SCHEDULE_CRON=
SCHEDULE_TZ=Australia/Sydney

# Optional: a project id owned by a DIFFERENT account, for the cross-tenant negative test
RHOMBUS_FOREIGN_PROJECT_ID=
