{
  "name": "rhombus-etl-drift-qa",
  "version": "0.1.0",
  "private": true,
  "description": "UI + API test suites for the Rhombus AI ETL take-home (S3 -> AI cleaning -> GCS, scheduled).",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "login": "playwright test --project=setup",
    "test": "playwright test",
    "test:ui": "PW_JSON=reports/playwright-ui.json playwright test --project=ui",
    "test:api": "PW_JSON=reports/playwright-api.json playwright test --project=api",
    "test:data": "cd data-validation && ../.venv/bin/python -m pytest -q --junitxml=../reports/pytest.xml",
    "lint:nosleep": "node scripts/check-no-sleep.mjs",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.4",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
